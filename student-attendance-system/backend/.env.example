# Copy this file to ".env" and edit. Every value is optional in development.
PORT=5000
NODE_ENV=development
# Where the React dev server runs (used for CORS). Vite proxy makes this mostly irrelevant in dev.
CLIENT_ORIGIN=http://localhost:5173
# REQUIRED in production. In development a random secret is generated once and kept in backend/.jwt-secret
JWT_SECRET=
# Login session length in hours
SESSION_HOURS=8
# College working days, 0=Sunday ... 6=Saturday
WORKING_DAYS=1,2,3,4,5
# Comma separated subject list
SUBJECTS=DBMS,DAA,Web Technology,Machine Learning
# Max upload size in MB
MAX_UPLOAD_MB=5
# Production only: credentials for the first admin account (created if no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
